<mxfile host="app.diagrams.net"><diagram name="Architecture" id="p1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="2300" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Scalable Web Application - AWS Cloud Architecture (EC2 + ALB + Auto Scaling + RDS MySQL Multi-AZ)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15" y="10" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Terraform | CloudFront + WAF + ALB + ASG (private subnets, 2 AZ) + RDS Multi-AZ (isolated DB subnets) + NAT per AZ + Session Manager + CloudWatch/SNS | Region: us-east-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="50" width="1900" height="25" as="geometry"/></mxCell><mxCell id="c4" value="AWS Cloud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="428" y="88" width="1745" height="1262" as="geometry"/></mxCell><mxCell id="c5" value="Region: us-east-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;fontColor=#147EBA;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="128" width="1700" height="1192" as="geometry"/></mxCell><mxCell id="c6" value="VPC 10.0.0.0/16 (DNS support + hostnames)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;fontColor=#8C4FFF;verticalAlign=top;align=right;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="513" y="173" width="1245" height="955" as="geometry"/></mxCell><mxCell id="c7" value="Public subnet 10.0.0.0/24 (AZ-a)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#248814;fontColor=#248814;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="245" width="575" height="170" as="geometry"/></mxCell><mxCell id="c8" value="Public subnet 10.0.1.0/24 (AZ-b)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#248814;fontColor=#248814;verticalAlign=top;align=right;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="245" width="575" height="170" as="geometry"/></mxCell><mxCell id="c9" value="Private app subnet 10.0.10.0/24 (AZ-a)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;fontColor=#147EBA;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="445" width="575" height="260" as="geometry"/></mxCell><mxCell id="c10" value="Private app subnet 10.0.11.0/24 (AZ-b)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;fontColor=#147EBA;verticalAlign=top;align=right;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="445" width="575" height="260" as="geometry"/></mxCell><mxCell id="c11" value="Private DB subnet 10.0.20.0/24 (AZ-a, no internet route)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;fontColor=#147EBA;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="725" width="575" height="215" as="geometry"/></mxCell><mxCell id="c12" value="Private DB subnet 10.0.21.0/24 (AZ-b, no internet route)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;fontColor=#147EBA;verticalAlign=top;align=right;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="725" width="575" height="215" as="geometry"/></mxCell><mxCell id="c13" value="Auto Scaling group (min 2 / desired 2 / max 6)&lt;br&gt;Target tracking CPU 50% / 500 req per target + step-out" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;fontColor=#ED7100;verticalAlign=bottom;align=right;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=0;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="1000" height="190" as="geometry"/></mxCell><mxCell id="c14" value="Security &amp; network controls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F0FB;strokeColor=#8C4FFF;fontColor=#000000;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="540" y="965" width="1195" height="150" as="geometry"/></mxCell><mxCell id="c15" value="Management, security &amp; monitoring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;fontColor=#000000;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1802" y="173" width="350" height="955" as="geometry"/></mxCell><mxCell id="c16" value="Not in the baseline (roadmap from the report)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;fontColor=#000000;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="473" y="1150" width="1680" height="165" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Security Groups:&lt;/b&gt; alb-sg (80/443 from 0.0.0.0/0) -&gt; web-sg (80 from alb-sg only) -&gt; rds-sg (3306 from web-sg only). &lt;b&gt;No port 22, no key pair, no public IP: Session Manager only.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#DD344C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="560" y="990" width="1160" height="35" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;NACLs:&lt;/b&gt; Public: in 80, 443, ephemeral 1024-65535, VPC CIDR; out all. Private (app + DB): in VPC CIDR + ephemeral (NAT return traffic); out all.&lt;br&gt;&lt;b&gt;Route tables:&lt;/b&gt; public -&gt; IGW | private app -&gt; NAT in the same AZ | DB -&gt; local only. One NAT per AZ (single_nat_gateway = false)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="560" y="1030" width="1160" height="80" as="geometry"/></mxCell><mxCell id="c19" value="1) Remote state in S3 (versioning, encryption, locking)&lt;br&gt;2) Restrict ALB to CloudFront only (managed prefix list + secret origin header, default action 403) - today users can hit the ALB directly&lt;br&gt;3) HTTPS end to end with ACM + Route 53 (CloudFront -&gt; ALB is HTTP today)&lt;br&gt;4) Modules + dev/prod | 5) VPC endpoints, KMS CMK, Flow Logs, CloudTrail, ALB/WAF logs&lt;br&gt;6) RDS: deletion protection, final snapshot, 7-day backups | 7) CI/CD (fmt, validate, tflint, tfsec, Infracost)&lt;br&gt;8) Real app using Secrets Manager + CloudWatch agent + Packer AMI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="495" y="1180" width="1640" height="130" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Request flow&lt;/b&gt;&lt;br&gt;1) User resolves the CloudFront URL (Route 53 optional, not enabled)&lt;br&gt;2) User -&gt; CloudFront (HTTPS, cache /static/*)&lt;br&gt;3) CloudFront -&gt; IGW -&gt; ALB (HTTP origin)&lt;br&gt;4) WAF inspects at the ALB&lt;br&gt;5) ALB -&gt; EC2 in private app subnets (port 80)&lt;br&gt;6) EC2 -&gt; RDS MySQL (3306)&lt;br&gt;/admin/* = 403 (ALB listener rule)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="410" width="400" height="125" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;ALB / WAF rules&lt;/b&gt;&lt;br&gt;L7 rule: /admin and /admin/* -&gt; fixed 403&lt;br&gt;WAF: Common, KnownBadInputs, SQLi, Linux rule sets + rate limit 2,000 req / 5 min / IP&lt;br&gt;Health check: /health" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="555" width="400" height="90" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Compute &amp; scaling&lt;/b&gt;&lt;br&gt;Launch Template: Amazon Linux 2023, IMDSv2, encrypted gp3&lt;br&gt;Target tracking: CPU 50%, ALB requests per target 500&lt;br&gt;Step scaling: scale-out only&lt;br&gt;Rolling instance refresh on template change" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="675" width="400" height="100" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Alarms (5)&lt;/b&gt;&lt;br&gt;ASG CPU, ALB 5xx, unhealthy hosts, RDS CPU, RDS free storage -&gt; SNS email&lt;br&gt;Dashboard with 4 widgets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="795" width="400" height="70" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Dark = request / database flow&lt;br&gt;&lt;font color=&quot;#E7157B&quot;&gt;Pink = management, alerts, monitoring&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8C4FFF&quot;&gt;Purple = NAT egress / edge&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DD344C&quot;&gt;Red = security (WAF, credentials)&lt;/font&gt;&lt;br&gt;Dashed = optional / alternative / replication path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="885" width="400" height="100" as="geometry"/></mxCell><mxCell id="c43" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="DNS (optional)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="HTTP (origin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="same ALB (multi-AZ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="759" y="108"/><mxPoint x="1217" y="108"/></Array></mxGeometry></mxCell><mxCell id="c48" value="associated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DD344C;strokeWidth=2;fontSize=10;fontColor=#DD344C;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="alias A record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="egress via NAT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="egress via NAT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="3306" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="3306" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1217" y="715"/><mxPoint x="759" y="715"/></Array></mxGeometry></mxCell><mxCell id="c56" value="sync replication (Multi-AZ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c